{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "d3d12-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "PARALLEL_ROAM_GRAPHICS_API": "D3D12"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug-vcpkg",
      "displayName": "Debug (vcpkg manifest)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "debug-fetch",
      "displayName": "Debug (FetchContent dependencies)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PARALLEL_ROAM_FETCH_MISSING_DEPS": "ON"
      }
    },
    {
      "name": "debug-d3d12",
      "displayName": "Debug - D3D12",
      "inherits": "d3d12-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug-d3d12-vcpkg",
      "displayName": "Debug - D3D12 (vcpkg manifest)",
      "inherits": "d3d12-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "debug-d3d12-fetch",
      "displayName": "Debug - D3D12 (FetchContent dependencies)",
      "inherits": "d3d12-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PARALLEL_ROAM_FETCH_MISSING_DEPS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-fetch",
      "displayName": "Release (FetchContent dependencies)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PARALLEL_ROAM_FETCH_MISSING_DEPS": "ON"
      }
    },
    {
      "name": "release-d3d12",
      "displayName": "Release - D3D12",
      "inherits": "d3d12-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-d3d12-fetch",
      "displayName": "Release - D3D12 (FetchContent dependencies)",
      "inherits": "d3d12-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PARALLEL_ROAM_FETCH_MISSING_DEPS": "ON"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "relwithdebinfo-fetch",
      "displayName": "RelWithDebInfo (FetchContent dependencies)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "PARALLEL_ROAM_FETCH_MISSING_DEPS": "ON"
      }
    },
    {
      "name": "relwithdebinfo-d3d12",
      "displayName": "RelWithDebInfo - D3D12",
      "inherits": "d3d12-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "relwithdebinfo-d3d12-fetch",
      "displayName": "RelWithDebInfo - D3D12 (FetchContent dependencies)",
      "inherits": "d3d12-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "PARALLEL_ROAM_FETCH_MISSING_DEPS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "debug-vcpkg",
      "configurePreset": "debug-vcpkg",
      "configuration": "Debug"
    },
    {
      "name": "debug-fetch",
      "configurePreset": "debug-fetch",
      "configuration": "Debug"
    },
    {
      "name": "debug-d3d12",
      "configurePreset": "debug-d3d12",
      "configuration": "Debug"
    },
    {
      "name": "debug-d3d12-vcpkg",
      "configurePreset": "debug-d3d12-vcpkg",
      "configuration": "Debug"
    },
    {
      "name": "debug-d3d12-fetch",
      "configurePreset": "debug-d3d12-fetch",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "release-fetch",
      "configurePreset": "release-fetch",
      "configuration": "Release"
    },
    {
      "name": "release-d3d12",
      "configurePreset": "release-d3d12",
      "configuration": "Release"
    },
    {
      "name": "release-d3d12-fetch",
      "configurePreset": "release-d3d12-fetch",
      "configuration": "Release"
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "relwithdebinfo-fetch",
      "configurePreset": "relwithdebinfo-fetch",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "relwithdebinfo-d3d12",
      "configurePreset": "relwithdebinfo-d3d12",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "relwithdebinfo-d3d12-fetch",
      "configurePreset": "relwithdebinfo-d3d12-fetch",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
